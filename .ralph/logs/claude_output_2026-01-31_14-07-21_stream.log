{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T9sBEXnuPFmuSmPEnKEyyQ","type":"tool_result","content":"[\n  {\n    \"id\": \"litehouse-x52\",\n    \"title\": \"in the elm app move the data fetching code out to its own module. Have one module/file per request and keep the decoders and stuff all together. as always, make sure the tests keep passing. look online for ideas on best practices if you aren't sure\",\n    \"status\": \"in_progress\",\n    \"priority\": 2,\n    \"issue_type\": \"task\",\n    \"owner\": \"danbruder@hey.com\",\n    \"created_at\": \"2026-01-31T13:25:06.085419-05:00\",\n    \"created_by\": \"Dan Bruder\",\n    \"updated_at\": \"2026-01-31T13:34:47.093038-05:00\"\n  },\n  {\n    \"id\": \"litehouse-rrs\",\n    \"title\": \"in the elm app move the effects to a module called Effects\\n\",\n    \"status\": \"open\",\n    \"priority\": 2,\n    \"issue_type\": \"task\",\n    \"owner\": \"danbruder@hey.com\",\n    \"created_at\": \"2026-01-31T13:25:38.914032-05:00\",\n    \"created_by\": \"Dan Bruder\",\n    \"updated_at\": \"2026-01-31T13:25:38.914032-05:00\"\n  },\n  {\n    \"id\": \"litehouse-9fv\",\n    \"title\": \"pages and sidebar in elm app\",\n    \"description\": \"i want the sidebar to show for each page and when someone clicks a link, it goes to a new page but with the page shell\",\n    \"status\": \"open\",\n    \"priority\": 2,\n    \"issue_type\": \"task\",\n    \"owner\": \"danbruder@hey.com\",\n    \"created_at\": \"2026-01-31T13:26:43.707907-05:00\",\n    \"created_by\": \"Dan Bruder\",\n    \"updated_at\": \"2026-01-31T13:26:43.707907-05:00\"\n  },\n  {\n    \"id\": \"litehouse-yp2\",\n    \"title\": \"make sure each page loads the data it needs on init\",\n    \"description\": \"for the case where someone visits a page via link directly in the elm app\",\n    \"status\": \"open\",\n    \"priority\": 2,\n    \"issue_type\": \"task\",\n    \"owner\": \"danbruder@hey.com\",\n    \"created_at\": \"2026-01-31